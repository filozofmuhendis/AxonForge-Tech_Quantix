# AxonForge Personal FinTech AI - Çevre Değişkenleri Şablonu

# Sistem Ayarları
TIMEZONE=Europe/Istanbul
LOG_LEVEL=INFO
DEFAULT_CURRENCY=TRY
AUTO_TRADING=false

# Veritabanı Ayarları (Sadece PostgreSQL Desteklenir)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/axonforge

# Önbellek & Görev Kuyruğu (Redis)
REDIS_URL=redis://localhost:6379/0

# Yapay ZKA Ajanı (LLM) Ayarları
# Desteklenen sağlayıcılar: ollama, openai, anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b-instruct
OLLAMA_HOST=http://localhost:11434

# Dış Yapay Zeka Sağlayıcıları (LLM_PROVIDER = openai veya anthropic ise gereklidir)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Finansal Veri Sağlayıcıları Anahtarları (İsteğe Bağlı)
POLYGON_API_KEY=
TWELVEDATA_API_KEY=
ALPHAVANTAGE_API_KEY=
BIST_PROVIDER_API_KEY=

# Aracı Kurum Entegrasyonları (Gerçek işlemler varsayılan olarak kapalıdır)
BROKER_PROVIDER=paper
IB_API_HOST=127.0.0.1
IB_API_PORT=7497
IB_CLIENT_ID=1

# Risk Gate Limitleri
MAX_POSITION_SIZE_PCT=0.10
MAX_DAILY_LOSS_LIMIT=50000
MAX_PORTFOLIO_EXPOSURE_PCT=0.80
DATA_FRESHNESS_LIMIT_SECONDS=900
