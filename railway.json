{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/backend.Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "healthcheckTimeout": 120,
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "docker/**",
      "requirements.txt"
    ]
  }
}
